{
  "name": "clippass",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "test": "vitest run",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "npm -w @clippass/web run dev",
    "setup": "tsx scripts/setup.ts",
    "claim": "tsx scripts/claim.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
